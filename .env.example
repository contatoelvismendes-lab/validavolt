# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# InfinitePay Configuration (Payments)
VITE_INFINITEPAY_PUBLIC_KEY=your-public-key
VITE_INFINITEPAY_WEBHOOK_SECRET=your-webhook-secret

# APIs de Telemetria de Montadoras (Optional)
VITE_TESLA_API_KEY=
VITE_VOLVO_API_KEY=
VITE_BYD_API_KEY=

# Feature Flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_BLUETOOTH=true
